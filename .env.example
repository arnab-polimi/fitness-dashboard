# ============================================================
# ApexFitness - Personal Fitness Intelligence Dashboard
# Environment Configuration Template
# ============================================================

# Database Configuration
FITNESS_DB_PATH=fitness_data.db
DB_ENGINE=sqlite  # sqlite or duckdb

# Optional Strava API Sync (Future Direct Sync Extension)
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
STRAVA_REFRESH_TOKEN=your_strava_refresh_token_here

# App Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
